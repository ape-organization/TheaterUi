private loadBooking(): void {
  const booking = this.booking();

  if (!booking?.seats) {
    return;
  }

  this.seats = booking.seats.map((seat: any) =>
    this.displaySeatLabel(seat.label)
  );

  // Generate a QR code for confirmed bookings containing the ticket data
  if (booking.status === 'CONFIRMED') {
    this.generateQrCode(booking);
  }
}

/** Build a compact ticket payload and render it as a QR code data URL */
private generateQrCode(booking: UserBooking): void {
  const payload = {
    id: booking.id,
    name: booking.user?.name ?? '',
    seats: booking.seats.map(s => s.label),
    status: booking.status,
    createdAt: booking.createdAt,
  };

  QRCode.toDataURL(JSON.stringify(payload), {
    width: 220,
    margin: 1,
    color: {
      dark: '#1a1a1a',
      light: '#ffffff',
    },
  })
    .then((url: string) => this.qrCodeDataUrl.set(url))
    .catch((err: unknown) => {
      console.error('Failed to generate QR code', err);
      this.qrCodeDataUrl.set(null);
    });
}
